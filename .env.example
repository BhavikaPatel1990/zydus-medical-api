PORT=7018
HOST=0.0.0.0
API_BASE_PATH=/zydus-medical-api
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5018,http://127.0.0.1:5018
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
AUTH_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<auth_database>
JWT_SECRET=<set-a-long-random-secret>
AUTH_SERVICE_URL=http://localhost:<auth-service-port>
FRONTEND_URL=http://localhost:5018
HIMS_PATIENT_SEARCH_URL=<patient-search-endpoint>
ENABLE_EMAIL=false
TENANT_ID=<microsoft-tenant-id>
CLIENT_ID=<microsoft-client-id>
CLIENT_SECRET=<microsoft-client-secret>
SMTP_FROM=<sender-address>
MAIL_HOST=<smtp-host>
MAIL_USER=<smtp-user>
MAIL_PASS=<smtp-password>
MAIL_PORT=587
